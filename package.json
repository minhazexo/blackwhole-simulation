{
  "name": "blackhole-simulation",
  "version": "1.0.0",
  "author": "Minhazexo",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=20"
  },
  "trustedDependencies": [
    "wasm-pack",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "bun run build:wasm && next dev --webpack",
    "dev:watch": "concurrently \"bun run watch:wasm\" \"next dev --webpack\"",
    "build": "bun run build:wasm && next build --webpack",
    "build:wasm": "cd physics-engine/gravitas-wasm && cross-env CARGO_BUILD_JOBS=1 wasm-pack build --target web --out-name blackhole_physics --out-dir ../../public/wasm",
    "watch:wasm": "cd physics-engine/gravitas-wasm && cross-env CARGO_BUILD_JOBS=1 cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-pack build --target web --out-name blackhole_physics --out-dir ../../public/wasm\"",
    "build:vercel": "bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,md,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "physics:regress": "cd physics-engine && cargo test --release -p gravitas-core --test conservation --test photon_ring --test isco --test schwarzschild_degenerate --test near_extremal --test normalize",
    "seo:check": "bun scripts/seo-provenance.ts src/seo/structured-data.ts",
    "seo:ping": "bun scripts/indexnow-ping.ts",
    "shader:check": "vitest run --config vitest.shader.config.ts",
    "shader:update-goldens": "bun scripts/update-goldens.ts",
    "postinstall": "bun scripts/setup-hooks.ts",
    "clean": "rimraf .next node_modules physics-engine/target public/wasm"
  },
  "dependencies": {
    "@react-three/drei": "10",
    "@react-three/fiber": "9",
    "framer-motion": "14.1.0",
    "gl-matrix": "^3.4.4",
    "lucide-react": "1.55.0",
    "next": "16",
    "react": "19",
    "react-dom": "19",
    "recharts": "3.10.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/three": "0.186.0",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.6.1",
    "concurrently": "10",
    "cross-env": "^10.1.0",
    "eslint": "9",
    "eslint-config-next": "16",
    "fast-check": "^4.10.2",
    "jsdom": "^28.1.0",
    "lefthook": "^2.2.1",
    "pixelmatch": "8",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wasm-pack": "^0.13.1"
  }
}
