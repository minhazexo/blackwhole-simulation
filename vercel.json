{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "crons": [],
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": "nextjs",
  "buildCommand": "bun run build:vercel",
  "installCommand": "bun install",
  "build": {
    "env": {
      "CARGO_BUILD_JOBS": "1",
      "RUSTFLAGS": "-C target-feature=+bulk-memory"
    }
  }
}
